with "../trusted_core/dezhan_trusted_core.gpr";
with "../storage/dezhan_storage.gpr";

library project Dezhan_Vault is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "dezhan_vault";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;

end Dezhan_Vault;
