with "../auth/dezhan_sigv4.gpr";

project Dezhan_Cli is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "obj";
   for Main use ("dezhan_cli.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-g");
   end Compiler;

end Dezhan_Cli;
