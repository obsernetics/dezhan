with "../vault/dezhan_vault.gpr";
with "../auth/dezhan_sigv4.gpr";

project Dezhan_Server is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "obj";
   for Main use ("dezhan_server.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;

   package Binder is
      --  Generous secondary stack: (de)compressing a multi-megabyte object
      --  returns whole-object arrays by value on the secondary stack.
      for Default_Switches ("Ada") use ("-D64m");
   end Binder;

end Dezhan_Server;
