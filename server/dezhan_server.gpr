with "../vault/dezhan_vault.gpr";
with "../auth/dezhan_sigv4.gpr";

project Dezhan_Server is

   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "obj";
   for Main use ("dezhan_server.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatwa", "-gnatwJ", "-g");
   end Compiler;

   package Binder is
      --  Generous secondary stack: a full-object GET returns the assembled
      --  object here, and (de)compression returns whole-object arrays by value.
      --  256 MB covers large single-object restores; bigger objects use ranged
      --  GETs and multipart.
      for Default_Switches ("Ada") use ("-D256m");
   end Binder;

end Dezhan_Server;
